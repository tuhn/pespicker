{
  "name": "pespicker",
  "version": "0.1.0",
  "private": true,
  "description": "Team Draw - random 1v1 team picker for PES 2021 sessions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:ratings": "node scripts/fetch-ratings.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "import:csv": "node scripts/import-csv.mjs",
    "report": "node scripts/report.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pespicker",
    "screenshot": "node scripts/screenshot.mjs",
    "preview:assets": "node scripts/preview-assets.mjs",
    "perf": "node scripts/perf.mjs",
    "check:pwa": "node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "esbuild": "0.28.2",
    "flag-icons": "7.6.0",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "svgo": "4.1.0"
  }
}
